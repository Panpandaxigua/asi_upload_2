  "validation_rules": {
    "description_format": {
      "label": "Description 格式",
      "message": "Description 格式错误",
      "rules": [
        {
          "message": "Description 包含中文标点符号",
          "pattern": "^[^\\u3000-\\u303f\\uff00-\\uffef\\u2018-\\u201d\\u201c-\\u201d\\u3001\\u3002\\u2014\\uff5e\\u2026\\u00b7]*$",
          "type": "regex"
        },
        {
          "message": "Description 超过800个字符上限",
          "value": 800,
          "type": "max_length"
        }
      ],
      "excel_columns": [
        "Description"
      ]
    },
    "summary_format": {
      "label": "Summary Description 格式",
      "message": "Summary Description 格式错误",
      "rules": [
        {
          "message": "Summary Description 包含中文标点符号",
          "pattern": "^[^\\u3000-\\u303f\\uff00-\\uffef\\u2018-\\u201d\\u201c-\\u201d\\u3001\\u3002\\u2014\\uff5e\\u2026\\u00b7]*$",
          "type": "regex"
        },
        {
          "message": "Summary Description 超过130个字符上限",
          "value": 130,
          "type": "max_length"
        }
      ],
      "excel_columns": [
        "Summary",
        "Summary Description"
      ]
    },
    "keywords_format": {
      "label": "Keywords 格式",
      "message": "Keywords 格式错误",
      "rules": [
        {
          "message": "Keywords 超过30个词上限",
          "separator": [
            ",",
            ",",
            ", "
          ],
          "value": 30,
          "type": "max_items"
        }
      ],
      "excel_columns": [
        "Keywords"
      ]
    },
    "product_theme_check": {
      "label": "Product Theme 校验",
      "message": "Product Theme 校验失败",
      "rules": [
        {
          "message": "Product Theme 不在合法选项中",
          "options_key": "product_theme",
          "type": "in_options",
          "multi": true
        },
        {
          "message": "Product Theme 超过5个上限",
          "separator": [
            ",",
            ",",
            ", "
          ],
          "value": 5,
          "type": "max_items"
        }
      ],
      "excel_columns": [
        "Theme",
        "Product Theme"
      ]
    },
    "origin_check": {
      "label": "产地/国家校验",
      "message": "产地/国家校验失败",
      "rules": [
        {
          "message": "国家/产地不在合法选项中",
          "options_key": "country",
          "type": "in_options"
        }
      ],
      "excel_columns": [
        "Manufactured In",
        "Assembled In",
        "Decorated In"
      ]
    },
    "num_items_format": {
      "label": "Number of Items 格式",
      "message": "Number of Items 格式错误",
      "rules": [
        {
          "message": "格式错误，应为：数字+空格+单位(Box/Case/Carton/Other)，如 30 Case",
          "pattern": "(?i)^\\d+(\\.\\d+)?\\s+(Box|Case|Carton|Other)$",
          "type": "regex"
        }
      ],
      "excel_columns": [
        "Number of Items"
      ]
    },
    "shipping_dims_format": {
      "label": "Shipping Dimensions 格式",
      "message": "Shipping Dimensions 格式错误",
      "rules": [
        {
          "message": "格式错误，应为：数字+空格+单位(in/cm/ft/meter/mm/yds)，如 20 in",
          "pattern": "(?i)^\\d+(\\.\\d+)?\\s+(in|cm|ft|meter|mm|yds)$",
          "type": "regex"
        }
      ],
      "excel_columns": [
        "Shipping Dimensions L",
        "Shipping Dimensions W",
        "Shipping Dimensions H"
      ]
    },
    "shipping_weight_format": {
      "label": "Shipping Weight 格式",
      "message": "Shipping Weight 格式错误",
      "rules": [
        {
          "message": "格式错误，应为：数字+空格+单位(grams/kg/oz/lbs)，如 20 lbs",
          "pattern": "(?i)^\\d+(\\.\\d+)?\\s+(grams|kg|oz|lbs)$",
          "type": "regex"
        }
      ],
      "excel_columns": [
        "Shipping Weight",
        "Shipping Weight "
      ]
    },
    "item_packaging_check": {
      "label": "Item Packaging 校验",
      "message": "Item Packaging 校验失败",
      "rules": [
        {
          "multi": true,
          "separator": [
            ",",
            ",",
            ", "
          ],
          "message": "Item Packaging 选项不在合法范围内",
          "options_key": "item_packaging",
          "type": "in_options"
        }
      ],
      "excel_columns": [
        "Item Packaging"
      ]
    },
    "product_color_check": {
      "label": "Product Color 校验",
      "message": "Product Color 校验失败",
      "rules": [
        {
          "multi": true,
          "separator": [
            ",",
            ",",
            ", "
          ],
          "message": "Product Color 选项不在合法范围内",
          "options_key": "product_color",
          "type": "in_options"
        }
      ],
      "excel_columns": [
        "Product Color"
      ]
    },
    "size_values_format": {
      "label": "Size_Values 格式（依赖 Select Size）",
      "message": "Size_Values 格式错误",
      "rules": [
        {
          "cases": [
            {
              "message": "格式: L=12.99 in; W=5.51 in; H=19.29 in (至少一个维度)",
              "pattern": "(?i)^\\s*(L|W|H)=\\d+(\\.\\d+)?\\s+(in|cm|ft|meter|mm|yds)(\\s*;\\s*(L|W|H)=\\d+(\\.\\d+)?\\s+(in|cm|ft|meter|mm|yds))*\\s*$",
              "when": "Dimension(L,W,H)"
            },
            {
              "message": "格式: 32 GB 或 128 MB",
              "pattern": "(?i)^\\d+(\\.\\d+)?\\s+(GB|MB)$",
              "when": "Capacity (GB, MB)"
            },
            {
              "message": "格式: 16 oz 或 2 lb",
              "pattern": "(?i)^\\d+(\\.\\d+)?\\s+(oz|lb)$",
              "when": "Volume (oz,lb)"
            },
            {
              "message": "格式: One Size 或 Custom: 12.99 x 5.51 x 19.29",
              "pattern": "(?i)^(One Size|Custom:\\s*.+)$",
              "when": "Other - (one size, custom)"
            },
            {
              "message": "格式: Standard: S, M, L, XL 或 One Size / Adjustable",
              "pattern": "(?i)^(Standard:\\s*.+|One Size|Adjustable)$",
              "when": "Apparel-Standard & Numbered - (S,M,L,10,12)"
            },
            {
              "message": "格式: Standard: S, M, L, XL 或 One Size / Adjustable",
              "pattern": "(?i)^(OSFA|Standard:\\s*.+)$",
              "when": "Apparel-Mens/Tall"
            },
            {
              "message": "格式: Standard: S, M, L, XL 或 One Size / Adjustable",
              "pattern": "(?i)^(OSFA|Standard:\\s*.+)$",
              "when": "Apparel-Womens/Tall"
            },
            {
              "message": "格式: Standard: S, M, L, XL 或 One Size / Adjustable",
              "pattern": "(?i)^Standard:\\s*.+$",
              "when": "Apparel-Boys"
            },
            {
              "message": "格式: Standard: S, M, L, XL 或 One Size / Adjustable",
              "pattern": "(?i)^Standard:\\s*.+$",
              "when": "Apparel-Girls"
            },
            {
              "message": "格式: Standard: S, M, L, XL 或 One Size / Adjustable",
              "pattern": "(?i)^Standard:\\s*.+$",
              "when": "Apparel-Youth"
            },
            {
              "message": "格式: 32C, 34C, 36D",
              "pattern": "(?i)^\\d{2}[A-Z](,\\s*\\d{2}[A-Z])*$",
              "when": "Apparel - Bra (32C)"
            },
            {
              "message": "格式: A, AB",
              "pattern": "(?i)^[A-Z]+(,\\s*[A-Z]+)*$",
              "when": "Apparel - Hosiery/Uniform (A, AB)"
            },
            {
              "message": "格式: 3 Months, 6 Months, 2T",
              "pattern": "(?i)^\\d+\\s+\\w+(,\\s*\\d+\\s+\\w+)*$",
              "when": "Apparel - Infant/Toddler (3 Months, 2T)"
            },
            {
              "message": "格式: Neck=15; Sleeve=32/33",
              "pattern": "(?i)^Neck=\\d+;\\s*Sleeve=\\d+(/\\d+)?$",
              "when": "Apparel - Dress Shirts (15-15 1/2)"
            },
            {
              "message": "格式: Waist=32; Inseam=32",
              "pattern": "(?i)^Waist=\\d+;\\s*Inseam=\\d+$",
              "when": "Apparel - Pants (32-32)"
            }
          ],
          "type": "conditional",
          "depends_on": "Select Size"
        }
      ],
      "excel_columns": [
        "Size_Values"
      ]
    },
